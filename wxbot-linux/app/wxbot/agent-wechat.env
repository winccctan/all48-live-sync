# ============================================================
# all48 微信机器人桥 · Linux 容器版配置
#
# 🔴🔴 这里**只放「机器环境」**：wx 在哪、用哪个号、状态存哪、云端地址与钥匙。
#   群白名单 / 推送路由 / 冷却 / AI 额度 / 机器人称呼 ……
#   **全部由云端下发**（KV `wxcfg:main`，接口 /api/wxcfg），改这里没有任何效果。
#   要改策略：改云端，桥 5 分钟内自己拉下来（或 docker restart 立刻生效）。
#   之所以这么分：那台机器只负责「跑」，不负责「管」；本地留一份等于两个真源，
#   迟早出现「云端改了没生效 / 本地改了被覆盖」的鬼故事。
# ============================================================
WX_BIN=wx
WX_ACCOUNT=test48

# 桥的游标/日志/已推记录/配置缓存（挂载到宿主机持久化）
XDG_CONFIG_HOME=/app/data/xdg

# 云端地址 + 钥匙（拿配置、拿指令表、取推送队列都用它）
WORKER_URL=https://all48-archive.yqz-tansy.workers.dev
WX_QUEUE_TOKEN=4862e20527b02667cb51c068

# 状态文件位置（属于「机器环境」，不是策略）
WX_CURSOR_FILE=/app/data/xdg/state/wxbot-cursor
WX_PUSH_SEEN=/app/data/xdg/state/wxpush-seen.json

# AI 走哪条链路：留空 = 走 worker 的 Workers AI（免费额度、零 key）
# 只有显式给 AI_KEY 才走外部付费厂商，这属于密钥，不进云端配置
AI_KEY=
