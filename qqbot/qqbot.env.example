# QQ 机器人环境变量（复制成 qqbot.env 后改，别提交到仓库）
# 用法：set -a && source qqbot.env && set +a && node qqbot/bot.mjs

# Worker 地址（一般不用改）
WORKER_URL=https://all48-archive.yqz-tansy.workers.dev

# 和手机 AutoJS 用的是同一个 token（all48-worker 的 WX_QUEUE_TOKEN secret）
WX_QUEUE_TOKEN=

# NapCat / Lagrange 的 OneBot 11 WebSocket 地址
ONEBOT_WS=ws://127.0.0.1:3001
# 如果 OneBot 侧设了 access_token 就填上
ONEBOT_TOKEN=

# 要推送的 QQ 群号，多个用逗号分隔
QQ_GROUPS=

# 轮询间隔（毫秒），10 秒够实时了；调小会多耗 KV 读额度
POLL=10000
