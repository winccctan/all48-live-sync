# 微信群指令桥 · 配置模板（复制成 agent-wechat.env，已在 .gitignore）
# 用法：set -a && source wxbot/agent-wechat.env && set +a

# agent-wechat CLI（npm 装到独立前缀后就在这里）
WX_BIN=/Users/tansy/.workbuddy/binaries/agent-wechat/bin/wx
# 账号别名（wx accounts list 里那个 Alias）
WX_ACCOUNT=test48
# 🔴 必须可写：CLI 要在这里做原子重命名，默认 ~/.config 会被沙箱拒
XDG_CONFIG_HOME=/tmp/awcfg

# 群指令后端（和 QQ 那条同一个接口）
WORKER_URL=https://all48-archive.yqz-tansy.workers.dev
WX_QUEUE_TOKEN=填 all48-live-sync/live-notify.env 里那一串

# 允许接指令的群（chatroom id，逗号分隔）。留空 = 所有群都接，建议显式写死。
WX_GROUPS=53524154991@chatroom

# 是否需要 @ 才响应：0 = 直接发 lg?名字 就回（默认），1 = 必须 @
WX_REQUIRE_MENTION=0

# 同群两条回复之间最少间隔（毫秒），防风控
WX_COOLDOWN=1500

# 事件游标文件（断线续传用，别删）
# 🔴 所在目录必须 chmod 700，否则 CLI 报 "cursor file requires a private owned directory"
WX_CURSOR_FILE=/tmp/awcfg/state/wxbot-cursor

# ── AI 聊天（可选，AI_KEY 留空 = 完全关闭，连 @ 也不回）──────────────────────
# 触发方式：群里 @ 本号 说话，或直接发 `ai?问题`；指令 lg?/rb? 永远优先。
# 兼容 OpenAI 协议的服务都行：DeepSeek / 通义 / Kimi / 自建 one-api 都只是换个 BASE。
AI_KEY=
AI_BASE=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# 每个群每天的 AI 回复上限，防刷
AI_DAILY=120
