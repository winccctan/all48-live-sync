# 红蓝歌会 · 直播礼物实时监听（本机跑法）
#
# 🔴 这是**没有国内服务器**时用的配置：长连接经 SCRAPE_PROXY 的国内出口出去。
#    如果你以后有了国内机器，就把 USE_PROXY 删掉、SCRAPE_PROXY 也删掉，让它直连。
#
# 这个文件含密钥，已在 .gitignore 里，别提交。

# 站点（机器对机器调用走 workers.dev，绕开自定义域的 Bot Fight）
SITE_URL=https://all48-archive.yqz-tansy.workers.dev

# 站点写入钥匙（= Worker secret INGEST_TOKEN_EXTRA）
INGEST_TOKEN=__INGEST__

# 口袋48 登录 token（与补档站 scraper/.env 里是同一个，过期就重跑 get-token.mjs）
POCKET48_TOKEN=__PT__

# 走代理：真正的关键开关。代理出口是杭州阿里云，所以云信长连接能进房。
USE_PROXY=1
SCRAPE_PROXY=__PROXY__

# 同时监听多少个在播直播间
NIM_ROOMS_MAX=6
NIM_PORT=8788
NIM_BIND=127.0.0.1
