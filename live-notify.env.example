# 直播开播/下播推送配置（复制成 live-notify.env，已 gitignore）
#
# ---- 盯谁 ----
# 王语晨 = GNZ48 TEAM NIII，口袋48 uid 89653517
WATCH_UID=89653517
# 多个用逗号：WATCH_UID=89653517,89653427

# ---- 推到哪（三选一，填几个就推几个）----
# ① 安卓真机（推荐，免费）：本机开一个取件口，手机上的 AutoJS6 脚本每 20 秒来取。
#    WX_QUEUE_TOKEN 等于密码，随便生成一串：openssl rand -hex 12
#    手机填的地址 = http://<本机局域网 IP>:8789，脚本见 wxbot/android-send.js
WX_QUEUE_PORT=8789
WX_QUEUE_TOKEN=

# ② 企业微信群机器人：群设置 → 群机器人 → 添加 → 复制 Webhook 地址
#    ⚠️ 只能用在「企业微信内部群」，普通微信群加不了（官方限制）
WECOM_HOOK=

# ③ 任意 HTTP 中转：POST {"text":"...","md":"..."}
#    例如本地 wechaty 起的服务 http://127.0.0.1:8788/push
WX_PUSH_URL=

# ---- 可选 ----
# 轮询间隔（毫秒，最小 20000）。60 秒足够，太快没必要
# POLL_MS=60000
# 进程刚起时她正好在播，要不要也补一条「开播」（默认不补，避免重启刷屏）
# NOTIFY_ON_BOOT=1
