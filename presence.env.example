# 云信 IM 服务端「在线状态订阅」配置模板
# 用法：cp presence.env.example presence.env 后填值（presence.env 已在 .gitignore）
# 🔴 必须是【该云信应用所有者】合法持有的服务端凭据。
#    本工具不会尝试获取、逆向或伪造；拿不到就保持留空，联网命令会明确拒绝执行。
# 🔴 AppSecret 只允许放在服务端，禁止进前端 / 禁止进 public 仓库。

# 云信控制台 AppKey（公开标识，但同样从配置读，不硬编码）
YUNXIN_APP_KEY=

# 云信控制台 AppSecret —— 用于 SHA1(AppSecret + Nonce + CurTime)
YUNXIN_APP_SECRET=

# 订阅人 accid：我们自己的一个 NIM 账号，在线状态事件会推给它的在线连接
# （事件通过客户端 onRecvSubscribeEvents 下发，需要一条常驻登录连接）
YUNXIN_SUB_ACCID=

# 可选：本地事件日志路径（默认 .cache/presence-log.json）
# PRESENCE_LOG_PATH=
